TOPIC: PERFORMING FREQUENCY DISTRIBUTIONS OVER MULTIPLE DATA

a) Ungrouped Frequency Distribution

import pandas as pd

df = pd.DataFrame({
    'ID':['1','2','3','4','5','6'],
    'Product_name':['alex','bob','cathy','doge','eric','fred'],
    'State':['Taminadu','Tamilnadu','Taminadu','Andra',
             'Madhyapradesh','Orissa'],
    'Salescount':['1000','2000','3500','450','560','250']
})

df

import matplotlib.pyplot as plt

plt.hist(df['State'])
plt.ylabel('Frequency count')
plt.xlabel('Data')
plt.title('My histogram')
plt.show()

OUTPUT:
DataFrame is displayed and histogram of State is displayed.


b) Grouped Frequency Distribution

import pandas as pd
import matplotlib.pyplot as plt

df = pd.DataFrame({
    'ID': ['1', '1', '2', '3', '4'],
    'Product_Name': ['CS', 'SE', 'SE', 'SE', 'CS'],
    'State': [60, 70, 59, 51, 80],
    'Salescount': [20, 21, 20, 22, 23]
})

display(df)

df.groupby('ID')['Salescount'].max().plot(
    kind='bar', legend=True)

plt.show()

OUTPUT:
Grouped frequency distribution is displayed using a bar plot.


c) Cumulative Frequency Distribution

from scipy import stats
import numpy as np

Salescount = [20, 21, 20, 22, 23]

a, b, c, d = stats.cumfreq(
    Salescount, numbins=4)

print("cumulative frequency : ", a)
print("Lower Limit : ", b)
print("bin size : ", c)
print("extra-points : ", d)

OUTPUT:
cumulative frequency : [2. 3. 4. 5.]
Lower Limit : 19.5
bin size : 1.0
extra-points : 0


d) Relative Frequency Distribution

from scipy import stats
import numpy as np

Salescount = [20, 21, 20, 22, 23]

a, b, c, d = stats.cumfreq(
    Salescount, numbins=4)

print("cumulative frequency : ", a)
print("Lower Limit : ", b)
print("bin size : ", c)
print("extra-points : ", d)

fig = plt.figure()
ax = fig.add_subplot(111)

ax.hist(
    Salescount,
    edgecolor='black',
    weights=np.ones_like(Salescount) /
    len(Salescount)
)

OUTPUT:
cumulative frequency : [2. 3. 4. 5.]
Lower Limit : 19.5
bin size : 1.0
